# RYO builder credential (issued by the hackathon organiser). Never commit the real .env.
RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=

# LLM for the council agents (Anthropic). `ant auth login` also works without this variable.
ANTHROPIC_API_KEY=
ARENA_MODEL=claude-opus-5
# Optional: reach Claude through OpenRouter's Anthropic-compatible endpoint instead.
# Set ANTHROPIC_API_KEY to the sk-or-... key, uncomment both lines, and prefix the model.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ARENA_MODEL=anthropic/claude-opus-5

# Ledger location (SQLite)
ARENA_DB=arena.db

# Phase 2 skills (news_verify, narrative_convergence)
TAVILY_API_KEY=
