# RYO builder credential (issued by the hackathon organiser). Never commit the real .env.
RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=

# LLM for the council agents (Anthropic). `ant auth login` also works without this variable.
ANTHROPIC_API_KEY=
ARENA_MODEL=claude-opus-5
# Optional: reach Claude through OpenRouter's Anthropic-compatible endpoint instead.
# Set ANTHROPIC_API_KEY to the sk-or-... key, uncomment both lines, and prefix the model.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ARENA_MODEL=anthropic/claude-opus-5

# Optional: any OpenAI-compatible provider (Venice, OpenRouter) via `--llm openai` / ARENA_LLM=openai.
# ARENA_LLM=openai
# OPENAI_BASE_URL=https://api.venice.ai/api/v1
# OPENAI_API_KEY=
# ARENA_MODEL=qwen3-235b-a22b-instruct-2507
# ARENA_MAX_TOKENS=4000

# Ledger location (SQLite)
ARENA_DB=arena.db

# Skills: news_verify uses Tavily when set, otherwise Venice web search through OPENAI_API_KEY
TAVILY_API_KEY=

# Optional receipt publishing (`arena decide --notify`, `arena watch --notify`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Public base URL of `arena serve`, used for permalinks in notifications
ARENA_PUBLIC_URL=
