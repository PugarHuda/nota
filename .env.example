# RYO builder credential (issued by the hackathon organiser). Never commit the real .env.
RYO_MCP_URL=https://app-ryochan.com/api/mcp
RYO_MCP_KEY=
# rest (POST /tools/{tool}/call) or mcp (JSON-RPC tools/call on the same URL)
RYO_TRANSPORT=rest

# LLM for the council agents (Anthropic). `ant auth login` also works without this variable.
ANTHROPIC_API_KEY=
# Or a bearer token instead of an API key (read when ANTHROPIC_API_KEY is empty)
# ANTHROPIC_AUTH_TOKEN=
NOTA_MODEL=claude-opus-5
# Optional: reach Claude through OpenRouter's Anthropic-compatible endpoint instead.
# Set ANTHROPIC_API_KEY to the sk-or-... key, uncomment both lines, and prefix the model.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# NOTA_MODEL=anthropic/claude-opus-5

# Optional: any OpenAI-compatible provider (Venice, OpenRouter) via `--llm openai` / NOTA_LLM=openai.
# NOTA_LLM=openai
# OPENAI_BASE_URL=https://api.venice.ai/api/v1
# OPENAI_API_KEY=
# Venice's own name for the same key; read when OPENAI_API_KEY is empty (council and news_verify search)
# VENICE_API_KEY=
# NOTA_MODEL=qwen3-235b-a22b-instruct-2507
# NOTA_MAX_TOKENS=8000

# Ledger location (SQLite)
NOTA_DB=nota.db
# 1 opens the ledger immutably (a serverless host; main.py sets it on Vercel); writes then answer 503
# NOTA_READONLY=1
# Postgres for backings, handle claims and the shared rate limit (Neon on the hosted demo); unset = the SQLite ledger
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Default voices for narrative_signal (Telegram public channels, Bluesky handles verified active Sep 2026)
NOTA_VOICES=tg:WatcherGuru,bs:decrypt.co,bs:unusualwhales.bsky.social

# Skills: news_verify uses Tavily when set, otherwise Venice web search through OPENAI_API_KEY
TAVILY_API_KEY=
# Optional CoinGecko demo key (free): price_crosscheck and technicals_crosscheck send it as x-cg-demo-api-key
COINGECKO_API_KEY=

# Optional receipt publishing (`nota decide --notify`, `nota watch --notify`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Public base URL of `nota serve`: permalinks in notifications, canonical/OG links, feeds, sitemap, A2A card
# NOTA_PUBLIC_URL=https://nota-ryo.vercel.app
